# Salin berkas ini menjadi .env.local lalu sesuaikan.

# --- Autentikasi lokal ---
AIKITA_USER=admin
AIKITA_PASS=admin
# Ganti dengan string acak panjang (mis. `openssl rand -hex 32`)
AIKITA_SESSION_SECRET=ganti-dengan-rahasia-acak-panjang

# --- Penyimpanan lokal ---
# Folder untuk aikita.db dan blobs/ (default: ./data)
# AIKITA_DATA_DIR=./data

# --- LLM lokal (opsional) ---
# Nilai di bawah adalah BAWAAN. Admin dapat mengubahnya lewat menu
# "Pengaturan AI" di aplikasi (tersimpan di tabel settings) termasuk
# uji koneksi dan pemilihan model dari server.
# Ollama (default), LM Studio: http://127.0.0.1:1234/v1/chat/completions
# llama.cpp server: http://127.0.0.1:8080/v1/chat/completions
# AIKITA_LLM_ENABLED=true
# AIKITA_LLM_URL=http://127.0.0.1:11434
# AIKITA_LLM_MODEL=llama3.2
# AIKITA_LLM_API_KEY=
# AIKITA_LLM_TIMEOUT_MS=20000

# --- Mode baca dokumen ---
# ocr (default, Tesseract) atau langchain (pemuat + pemecah potongan + rantai QA)
# Bawaan; admin dapat menggantinya lewat menu "Pengaturan AI".
# AIKITA_INGESTION_MODE=ocr
